# LLM Provider Configuration
# Options: "mock" (default) or real providers (e.g., "groq", "gemini", "ollama")
LLM_PROVIDER=mock

# Maximum concurrent LLM calls across all jobs
LLM_CONCURRENCY=5

# Mock LLM Settings
MOCK_LATENCY_MS=200
MOCK_FAILURE_RATE=0.1

# Real Provider API Keys (if using real LLM)
# GROQ_API_KEY=
# GEMINI_API_KEY=
