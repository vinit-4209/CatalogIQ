# LLM Provider Configuration
# Options: "mock" (default) or "groq" (free)
LLM_PROVIDER=mock

# Maximum concurrent LLM calls across all jobs
LLM_CONCURRENCY=5

# Mock LLM Settings
MOCK_LATENCY_MS=200
MOCK_FAILURE_RATE=0.1

# Groq Configuration (Free Tier: https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
